<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarnOn>3390</WarnOn>
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <PackageId>Flap</PackageId>
    <Description>A clap-inspired, pipe-friendly command line parser for F#. Native AOT and Fable compatible.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Arg.fs" />
    <Compile Include="Matches.fs" />
    <Compile Include="Help.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Completions.fs" />
    <Compile Include="Command.fs" />
  </ItemGroup>

</Project>
