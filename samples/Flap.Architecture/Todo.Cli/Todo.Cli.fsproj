<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>todo</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <!-- FSharp.Core itself raises trim/AOT analysis warnings; they are not ours to fix. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Organised by slice: one folder per command. Each slice file holds the Flap definition,
       the mapper to the domain command and the partial active pattern that ties them together. -->
  <ItemGroup>
    <Compile Include="Shared.fs" />
    <Compile Include="Add/AddCli.fs" />
    <Compile Include="Complete/CompleteCli.fs" />
    <Compile Include="List/ListCli.fs" />
    <Compile Include="Completions/CompletionsCli.fs" />
    <Compile Include="Cli.fs" />
    <Compile Include="FileStore.fs" />
    <Compile Include="Program.fs" />
    <ProjectReference Include="../Todo.Domain/Todo.Domain.fsproj" />
    <ProjectReference Include="../../../src/Flap/Flap.fsproj" />
  </ItemGroup>

</Project>
